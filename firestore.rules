rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function normalizedEmail() {
      return request.auth.token.email;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.email_verified == true
        && normalizedEmail() == 'cuongtv@uit.edu.vn';
    }

    function rosterPath(courseId) {
      return /databases/$(database)/documents/courses/$(courseId)/roster/$(normalizedEmail());
    }

    function isActiveStudent(courseId) {
      return signedIn()
        && request.auth.token.email_verified == true
        && exists(rosterPath(courseId))
        && get(rosterPath(courseId)).data.active == true
        && get(rosterPath(courseId)).data.role == 'student';
    }

    function sessionPath(courseId, sessionId) {
      return /databases/$(database)/documents/courses/$(courseId)/attendanceSessions/$(sessionId);
    }

    function sessionSecretPath(courseId, sessionId) {
      return /databases/$(database)/documents/courses/$(courseId)/attendanceSessions/$(sessionId)/private/config;
    }

    match /courses/{courseId} {
      allow read: if signedIn();
      allow write: if isAdmin();

      match /roster/{email} {
        allow read: if isAdmin()
          || (signedIn()
            && request.auth.token.email_verified == true
            && normalizedEmail() == email);
        allow write: if isAdmin();
      }

      match /attendanceSessions/{sessionId} {
        allow read: if isAdmin() || isActiveStudent(courseId);
        allow create, update, delete: if isAdmin();

        match /private/{documentId} {
          allow read, write: if isAdmin();
        }

        match /records/{email} {
          allow read: if isAdmin()
            || (isActiveStudent(courseId) && normalizedEmail() == email);

          allow create: if isActiveStudent(courseId)
            && normalizedEmail() == email
            && request.resource.data.keys().hasOnly([
              'email', 'uid', 'studentId', 'fullName', 'classCode',
              'pinProof', 'requestId', 'checkedInAt', 'status', 'statusLabel',
              'verificationMode', 'evidenceLevel', 'qrVerified',
              'photoProvided', 'reviewStatus'
            ])
            && request.resource.data.email == normalizedEmail()
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.studentId is string
            && request.resource.data.fullName is string
            && request.resource.data.classCode is string
            && request.resource.data.requestId is string
            && request.resource.data.requestId.size() > 0
            && request.resource.data.checkedInAt == request.time
            && request.resource.data.status == 'recorded'
            && request.resource.data.statusLabel == 'Đã ghi nhận'
            && request.resource.data.verificationMode == 'pin_only'
            && request.resource.data.evidenceLevel == 'limited'
            && request.resource.data.qrVerified == false
            && request.resource.data.photoProvided == false
            && request.resource.data.reviewStatus == 'needs_review'
            && request.resource.data.pinProof is string
            && request.resource.data.pinProof.size() == 64
            && request.resource.data.pinProof == get(sessionSecretPath(courseId, sessionId)).data.pinProof
            && get(sessionPath(courseId, sessionId)).data.status == 'open'
            && request.time < get(sessionPath(courseId, sessionId)).data.expiresAt;

          allow update, delete: if isAdmin();
        }
      }

      match /assignments/{assignmentId} {
        allow read: if isAdmin() || isActiveStudent(courseId);
        allow write: if isAdmin();

        match /submissions/{email} {
          allow read: if isAdmin()
            || (isActiveStudent(courseId) && normalizedEmail() == email);
          allow create: if isActiveStudent(courseId)
            && normalizedEmail() == email
            && request.resource.data.email == normalizedEmail()
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.status == 'submitted'
            && request.resource.data.contentSha256 is string
            && request.resource.data.contentSha256.size() == 64
            && request.resource.data.mcqScore is number
            && request.resource.data.essayGradingStatus == 'pending'
            && request.resource.data.evidenceStatus in ['pending', 'ready'];
          allow update: if isActiveStudent(courseId)
            && normalizedEmail() == email
            && resource.data.email == request.resource.data.email
            && resource.data.uid == request.resource.data.uid
            && resource.data.submissionId == request.resource.data.submissionId
            && resource.data.contentSha256 == request.resource.data.contentSha256
            && resource.data.status == 'submitted'
            && request.resource.data.status == 'submitted'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'evidenceStatus', 'evidence', 'receiptEmail', 'updatedAt'
            ]);
          allow update, delete: if isAdmin();
        }
      }

      match /{document=**} {
        allow read, write: if isAdmin();
      }
    }
  }
}
